@assert execute if entity @s[advancements={the_last_sword:liberator=true}]
@shot wraith-freed

@step S16 the note: where is she?
# the item sits in a glow item frame in the structure: a survival punch drops it (a creative one does not)
execute as @e[type=minecraft:glow_item_frame,nbt={Item:{id:"the_last_sword:where_is_it_note"}},limit=1,sort=nearest] at @s rotated as @s run tp @p ^ ^ ^1.5 facing entity @s
@wait 5t
@aim entity @e[type=minecraft:glow_item_frame,nbt={Item:{id:"the_last_sword:where_is_it_note"}},limit=1,sort=nearest]
@key key.attack
@wait 10t
execute at @e[type=minecraft:item,nbt={Item:{id:"the_last_sword:where_is_it_note"}},limit=1,sort=nearest] run tp @s ~ ~ ~
@wait 1s
@shot where-is-it-note
@assert execute if items entity @s container.* the_last_sword:where_is_it_note
@assert execute if entity @s[advancements={the_last_sword:queens_whereabouts=true}]

