@expect chat message.the_last_sword.dragon_cult_raid_victory_reward within 30s
@assert execute if entity @s[advancements={the_last_sword:dragon_cult_raid_victory=true}]
@shot raid-won

@step S9 the dragon cult's secret letter
# the raid's priest always drops it; picking it up (with the raid won) grants the stage
execute at @e[type=minecraft:item,nbt={Item:{id:"the_last_sword:dragon_cult_secret_letter"}},limit=1,sort=nearest] run tp @s ~ ~ ~
@wait 3s
@assert execute if items entity @s container.* the_last_sword:dragon_cult_secret_letter
@assert execute if entity @s[advancements={the_last_sword:nether_traveler_outpost=true}]

@step S10 the traveler's hold, in the Nether
# its two glow item frames carry the authors' world coordinates (TileX/Y/Z), so generation logs one ERROR each;
# the frames survive and work (S11 takes the message from one) -- noise, not a defect
@allow error Block-attached entity at invalid position
@goto structure the_last_sword:travelers_hold in minecraft:the_nether
@wait 3s
@assert execute if entity @s[advancements={the_last_sword:travelers_hold_discover=true}]
@shot travelers-hold

@step S11 the traveler's message
# the item sits in a glow item frame in the structure: a survival punch drops it (a creative one does not)
execute as @e[type=minecraft:glow_item_frame,nbt={Item:{id:"the_last_sword:traveler_message"}},limit=1,sort=nearest] at @s rotated as @s run tp @p ^ ^ ^1.5 facing entity @s
@wait 5t
@aim entity @e[type=minecraft:glow_item_frame,nbt={Item:{id:"the_last_sword:traveler_message"}},limit=1,sort=nearest]
@key key.attack
@wait 10t
execute at @e[type=minecraft:item,nbt={Item:{id:"the_last_sword:traveler_message"}},limit=1,sort=nearest] run tp @s ~ ~ ~
@wait 1s
@shot traveler-message
@assert execute if items entity @s container.* the_last_sword:traveler_message
@assert execute if entity @s[advancements={the_last_sword:journey_to_end=true}]

@step S12 the End's reset ruins
# the audio device complains when many sounds stop at once on arrival: not the mod's
@allow error OpenAlUtil
# the mod's End structures stand in the outer End (beyond about 1000 blocks from the centre)
execute in minecraft:the_end run tp @s 1500 120 0
effect give @s minecraft:slow_falling 30 0 true
@goto structure the_last_sword:end_reset in minecraft:the_end
@wait 3s
@assert execute if entity @s[advancements={the_last_sword:end_reset_discover=true}]
@shot end-reset

@step S13 the lost altar
@goto structure the_last_sword:end_lost_altar in minecraft:the_end
@wait 3s
@assert execute if entity @s[advancements={the_last_sword:end_lost_altar_discover=true}]
@shot lost-altar

@step S17 the Wound of Time
@goto structure the_last_sword:wound_of_time in minecraft:the_end
@wait 3s
@assert execute if entity @s[advancements={the_last_sword:beyond_time=true}]
@shot wound-of-time

@step S18 the queen's trial
# she waits in the Wound of Time; coming within 4 blocks starts her boss show, at its end she is ready. One is summoned
# only if this spot has none
execute unless entity @e[type=the_last_sword:the_past_shadow_of_the_queen,distance=..96] run summon the_last_sword:the_past_shadow_of_the_queen ~ ~ ~3
execute as @e[type=the_last_sword:the_past_shadow_of_the_queen,limit=1,sort=nearest] at @s rotated as @s run tp @p ^ ^ ^2.5 facing entity @s
@expect chat bossshow.the_last_sword.the_past_shadow_of_the_queen.subtitle_2 within 30s
@wait 10s
item replace entity @s weapon.mainhand with the_last_sword:the_last_sword_you_never_forgot
@aim entity the_last_sword:the_past_shadow_of_the_queen
@key key.attack
@expect chat dialogue.the_last_sword.queen.combat.death_1 within 10s
# her reward comes at death tick 100 and grants the last stage
@wait 7s
@assert execute if entity @s[advancements={the_last_sword:proof_of_sovereignty=true}]
@assert execute if items entity @s container.* the_last_sword:the_givers_pain
@shot proof-of-sovereignty
# The sealed spire's stages come last: on these builds its chunk crashes the game as it generates (TLS-056, a
# known S1). Everything else in the story runs before it; once TLS-056 is fixed they run like any other stage.
@step S14 the sealed spire
@goto structure the_last_sword:sealed_spire in minecraft:the_end
@wait 3s
@assert execute if entity @s[advancements={the_last_sword:sealed_spire_discover=true}]
@shot sealed-spire

@step S15 free the Lost Wraith
# a dragon egg on the sleeping wraith wakes it (its boss show plays, a 110-tick wake), then it must be beaten: 400
# health, each hit capped at 10. The spire's own wraith is used; one is summoned only if this spot has none
execute unless entity @e[type=the_last_sword:lost_wraith,distance=..96] run summon the_last_sword:lost_wraith ~ ~ ~4
item replace entity @s weapon.mainhand with minecraft:dragon_egg
execute if entity @e[type=the_last_sword:lost_wraith] at @s rotated as @s run tp @e[type=the_last_sword:lost_wraith,limit=1,sort=nearest] ^ ^ ^2
@wait 5t
@aim entity the_last_sword:lost_wraith
@key key.use
@expect chat bossshow.the_last_sword.lost_wraith.subtitle_1 within 10s
@wait 8s
item replace entity @s weapon.mainhand with the_last_sword:the_last_sword_you_never_forgot
execute as @e[type=the_last_sword:lost_wraith] run data merge entity @s {NoAI:1b}
execute if entity @e[type=the_last_sword:lost_wraith] at @s rotated as @s run tp @e[type=the_last_sword:lost_wraith,limit=1,sort=nearest] ^ ^ ^2
@wait 5t
@aim entity the_last_sword:lost_wraith if-present
@key key.attack
@wait 10t
execute if entity @e[type=the_last_sword:lost_wraith] at @s rotated as @s run tp @e[type=the_last_sword:lost_wraith,limit=1,sort=nearest] ^ ^ ^2
@wait 5t
